{
  "name": "legal-notes",
  "version": "1.0.35",
  "description": "Legal notes for documentation-, home- and websites.",
  "keywords": [
    "about",
    "homepage",
    "impressum",
    "imprint",
    "legal",
    "notes",
    "website"
  ],
  "homepage": "https://github.com/thaibault/legal-notes",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/legal-notes.git"
  },
  "type": "module",
  "main": "index.compiled.html",
  "files": [
    "index.html"
  ],
  "scripts": {
    "build": "html-minifier --config-file htmlMinifierConfig.json --output index.compiled.html index.html",
    "clear": "rimraf --glob '*.compiled.html'",
    "prepare": "yarn build",
    "test": "yarn build && cat index.compiled.html"
  },
  "devDependencies": {
    "html-minifier": "^5.4.1",
    "rimraf": "^6.1.4"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
