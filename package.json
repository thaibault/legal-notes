{
  "name": "legal-notes",
  "version": "1.0.28",
  "license": "CC-BY-3.0",
  "description": "Legal notes for documentation-, home- and websites.",
  "homepage": "https://torben.website/legal-notes",
  "keywords": [
    "about",
    "homepage",
    "impressum",
    "imprint",
    "legal",
    "notes",
    "website"
  ],
  "files": [
    "index.html"
  ],
  "main": "index.compiled.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/legal-notes.git"
  },
  "scripts": {
    "build": "html-minifier --config-file htmlMinifierConfig.json --output index.compiled.html index.html",
    "clear": "rimraf --glob '*.compiled.html'",
    "test": "yarn build && cat index.compiled.html",
    "prepare": "yarn build"
  },
  "devDependencies": {
    "html-minifier": "^4.0.0",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
