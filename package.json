{
  "name": "legal-notes",
  "version": "1.0.29-1",
  "description": "Legal notes for documentation-, home- and websites.",
  "keywords": [
    "about",
    "homepage",
    "impressum",
    "imprint",
    "legal",
    "notes",
    "website"
  ],
  "homepage": "https://tsickert.com/legal-notes",
  "license": "CC-BY-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/legal-notes.git"
  },
  "type": "module",
  "main": "index.compiled.html",
  "files": [
    "index.html"
  ],
  "scripts": {
    "build": "html-minifier --config-file htmlMinifierConfig.json --output index.compiled.html index.html",
    "clear": "rimraf --glob '*.compiled.html'",
    "prepare": "yarn build",
    "test": "yarn build && cat index.compiled.html"
  },
  "devDependencies": {
    "html-minifier": "^4.0.0",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
